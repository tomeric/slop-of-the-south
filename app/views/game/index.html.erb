<div id="game" data-player-id="<%= @player_id %>"></div>

<div id="hud">
  <div id="signs">
    <%# One sign: the town or village big, the wijk and the street small beneath it %>
    <div id="sign" class="bord" hidden>
      <div id="sign-place"></div>
      <div id="sign-street" class="bord-straat"></div>
    </div>
    <%# biome of the current tile (stad, woonwijk, akkerland, weiland, boomgaarden, bos, water …) %>
    <div id="biome"></div>
    <%# game time: a full day every 6 minutes (DayNight.js) %>
    <div id="clock"></div>
    <div id="players"></div>
    <%# what all of us have flattened this round, in euros of WOZ value (Round.js, lib/game/round.rb) %>
    <div id="schade" hidden></div>
    <%# the shared action: teleport or vehicle switch, one per minute %>
    <div id="actie" hidden></div>
  </div>
  <%# the route (Round.js), up the right of the screen: the float where it is on the way from start (bottom) to end (top), an icon per stretch with obstacles still standing %>
  <div id="route" class="route" hidden>
    <div class="route-kop"></div>
    <div class="route-balk"><div class="route-gedaan"></div><div class="route-iconen"></div><div class="route-optocht">🚜</div></div>
  </div>
  <%# round start / result banner in the middle of the screen %>
  <div id="banner" class="bord" hidden><div id="banner-titel"></div><div id="banner-sub" class="bord-wijk"></div></div>
  <div id="flits" hidden></div>
  <%# the vehicle you drive and its trick (Vehicles.js); the bar fills while the trick recharges %>
  <div id="voertuig"><b id="voertuig-naam"></b> <span id="voertuig-hint"></span><div class="cooldown"><i id="cooldown-bar"></i></div></div>
  <div id="speed">
    <div id="drift" hidden>DRIFT <span id="drift-pips">○○○</span></div>
    <div id="boost"><div id="boost-fill"></div></div>
    <span id="kmh">0</span><small>km/h</small>
  </div>
</div>

<div id="burn"></div>
<canvas id="minimap" class="minimap"></canvas>
<div id="help">W A S D of pijltjes · spatie + sturen = driften (loslaten = turbo) · shift = boost · E wapen · V voertuig · Q rechtzetten · R terug op de weg · M kaart (klik = teleport) · N muziek</div>

<%# the loading screen between rounds (LoadingScreen.js): the town's pictures, name and story while the tiles stream in %>
<div id="laden" hidden>
  <div class="laden-foto"></div><div class="laden-foto"></div>
  <%# the arena with the route through it (Minimap.showArena) and the obstacles along it (Round.routeBar) %>
  <canvas id="laden-kaart"></canvas>
  <div id="laden-route" class="route">
    <div class="route-kop"></div>
    <div class="route-balk"><div class="route-gedaan"></div><div class="route-iconen"></div><div class="route-optocht">🚜</div></div>
  </div>
  <div class="laden-tekst">
    <div class="laden-kop"></div>
    <div class="laden-titel"></div>
    <p class="laden-info"></p>
  </div>
  <div class="laden-voet">
    <div class="laden-status"></div>
    <div class="laden-balk"><i></i></div>
    <div class="laden-bron">Foto's en tekst: Wikipedia</div>
  </div>
</div>
<%# the vote between rounds (VoteScreen.js): pick the next town from the list, or type one %>
<div id="stemmen" hidden>
  <div class="stem-kop"></div>
  <h2>Waar gaat de optocht heen?</h2>
  <div class="stem-lijst"></div>
  <input class="stem-plaats" type="text" maxlength="40" placeholder="Of typ een plaats in Limburg en druk op Enter" autocomplete="off" spellcheck="false">
  <div class="stem-klok"></div>
  <label class="naam">Jouw naam <input type="text" maxlength="16" autocomplete="off" spellcheck="false" placeholder="Chauffeur"></label>
</div>
<%# the vehicle picker (Picker.js): three cards, over the loading screen between towns or on V during a round %>
<div id="kiezer" hidden>
  <div class="kiezer-kop"><span>Kies je voertuig</span><a id="vrij-link" href="?vrij">Vrij rijden</a><label class="naam">Jouw naam <input type="text" maxlength="16" autocomplete="off" spellcheck="false" placeholder="Chauffeur"></label></div>
  <div class="kaarten"></div>
  <div class="kiezer-hint"></div>
</div>
<%# the parade's music: a hidden YouTube player (Music.js) %>
<div id="muziek"></div>

<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #9fb8cf;
               font-family: "Avenir Next", "Segoe UI", system-ui, sans-serif; }
  [hidden] { display: none !important; }
  #game canvas { display: block; }
  #hud { position: fixed; inset: 0; pointer-events: none; color: #1d2b1f; }
  #signs { position: absolute; left: 28px; top: 22px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }

  /* Dutch road-sign look: RAL 5017-ish blue, white text, thin white frame just inside the edge */
  .bord { position: relative; background: #0f3f8f; color: #fff; border-radius: 6px; padding: 11px 22px 12px;
          font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-weight: 700; text-transform: uppercase;
          letter-spacing: .06em; text-align: center; box-shadow: 0 2px 6px rgba(0, 0, 0, .25); }
  .bord::after { content: ""; position: absolute; inset: 4px; border: 2px solid #fff; border-radius: 3px; pointer-events: none; }
  #sign { min-width: 240px; font-size: 28px; line-height: 1.05; }
  .bord-straat { font-size: 13px; font-weight: 500; letter-spacing: .14em; opacity: .95; margin-top: 5px; }
  .bord-straat:empty { display: none; }
  .bord-wijk { font-size: 12px; font-weight: 500; letter-spacing: .16em; opacity: .95; margin-bottom: 4px; }
  .bord-wijk:empty { display: none; }
  .bord-plaats { font-size: 16px; padding: 7px 16px 8px; }
  #players, #biome, #clock, #actie, #schade { font-size: 14px; background: rgba(255, 255, 255, .6); padding: 3px 9px; border-radius: 4px; }
  #schade { font-variant-numeric: tabular-nums; font-weight: 700; color: #8a1414; background: rgba(255, 236, 236, .72); }
  #actie { font-variant-numeric: tabular-nums; }
  .route { position: absolute; width: 40px; }
  #route { right: 30px; top: 50%; transform: translateY(-52%); height: min(54vh, 500px); }
  .route-kop { position: absolute; bottom: 100%; right: 0; margin-bottom: 12px; white-space: nowrap; font-size: 12px; letter-spacing: .2em;
               text-transform: uppercase; background: rgba(255, 255, 255, .6); color: #1d2b1f; padding: 3px 9px; border-radius: 4px; }
  .route-balk { position: absolute; inset: 0; border-radius: 20px; background: rgba(18, 22, 30, .55); box-shadow: 0 2px 8px rgba(0, 0, 0, .25); }
  .route-gedaan { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 20px; background: linear-gradient(0deg, #e0241a, #f2c14e); opacity: .6; }
  .route-icoon { position: absolute; left: 50%; transform: translate(-50%, 50%); font-size: 17px; line-height: 1; }
  .route-icoon.meer::after { content: attr(data-n); position: absolute; right: -11px; top: -6px; font: 700 9px/1 "Helvetica Neue", Helvetica, Arial, sans-serif;
                             background: #fff; color: #111; border-radius: 6px; padding: 2px 3px; }
  .route-optocht { position: absolute; left: 50%; transform: translate(-50%, 50%); font-size: 30px; line-height: 1; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .6)); }
  #banner { position: absolute; left: 50%; top: 16%; transform: translateX(-50%); font-size: 40px; padding: 16px 44px 18px; white-space: nowrap; }
  #banner .bord-wijk { font-size: 15px; margin: 6px 0 0; }
  #flits { position: absolute; left: 50%; bottom: 120px; transform: translateX(-50%); background: rgba(18, 22, 30, .85); color: #fff;
           padding: 10px 18px; border-radius: 8px; font-size: 16px; white-space: nowrap; }
  #biome { font-style: italic; text-transform: capitalize; }
  #clock { font-variant-numeric: tabular-nums; }
  #biome:empty { display: none; }
  #players:empty { display: none; }

  #speed { position: absolute; right: 28px; bottom: 24px; text-align: right;
           font-size: 72px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  #speed small { display: block; font-size: 16px; font-weight: 500; opacity: .7; }
  #boost { width: 210px; height: 9px; margin: 0 0 10px auto; border-radius: 5px; background: rgba(0,0,0,.18); overflow: hidden; transition: transform .15s; }
  #boost.pop { transform: scaleY(1.7); }
  #boost-fill { height: 100%; width: 100%; transform-origin: left; background: linear-gradient(90deg, #ff7a1a, #ffd23c); transition: filter .2s; }
  #boost.on #boost-fill { filter: brightness(1.45) saturate(1.3); }
  #drift { font-size: 14px; font-weight: 700; letter-spacing: .12em; color: #0f3f8f; margin-bottom: 6px; }
  #drift.l3 { color: #b8002f; }
  #help { position: fixed; left: 28px; bottom: 24px; font-size: 13px; color: #1d2b1f; opacity: .65; }
  #burn { position: fixed; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, rgba(255, 120, 0, .25), rgba(180, 20, 0, .85)); opacity: 0; transition: opacity .5s; }
  #burn.on { opacity: 1; transition: opacity .05s; }
  .minimap { position: fixed; left: 28px; bottom: 52px; width: 230px; height: 230px; border: 3px solid #fff; border-radius: 50%;
             box-shadow: 0 3px 10px rgba(0, 0, 0, .3); background: #e8e4d8; cursor: pointer; }
  .minimap.expanded { left: 50%; top: 50%; bottom: auto; transform: translate(-50%, -50%); width: min(92vw, 92vh); height: min(92vw, 92vh);
                      border-radius: 14px; cursor: crosshair; }
  .minimap.expanded:active { cursor: grabbing; }

  #laden { position: fixed; inset: 0; z-index: 5; background: #0b0d12; color: #fff; overflow: hidden;
           font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .laden-foto { position: absolute; inset: 0; background: center / cover no-repeat; opacity: 0; transition: opacity 1.4s ease; }
  .laden-foto.on { opacity: 1; }
  #laden::after { content: ""; position: absolute; inset: 0; pointer-events: none;
                  background: linear-gradient(to top, rgba(8, 10, 16, .96) 0%, rgba(8, 10, 16, .6) 38%, rgba(8, 10, 16, 0) 70%); }
  .laden-tekst { position: absolute; left: 8vw; right: 8vw; bottom: 17vh; z-index: 1; }
  .laden-kop { font-size: 15px; letter-spacing: .3em; text-transform: uppercase; opacity: .8; margin-bottom: 8px; }
  .laden-titel { font-size: clamp(44px, 8vw, 110px); font-weight: 800; line-height: .95; letter-spacing: -.02em; text-transform: uppercase; }
  .laden-info { max-width: 64ch; font-size: 18px; line-height: 1.45; margin: 18px 0 0; opacity: .92; }
  .laden-voet { position: absolute; left: 8vw; right: 8vw; bottom: 6vh; z-index: 1; }
  .laden-status { font-size: 14px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 8px; min-height: 1.2em; }
  .laden-balk { height: 4px; background: rgba(255, 255, 255, .2); border-radius: 2px; overflow: hidden; }
  .laden-balk i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #e0241a, #f2c14e, #2a9d3a); transition: width .3s; }
  .laden-bron { font-size: 11px; opacity: .5; margin-top: 8px; }
  #muziek { position: fixed; left: -300px; top: -300px; width: 1px; height: 1px; opacity: .01; pointer-events: none; }

  #voertuig { position: absolute; left: 50%; bottom: 52px; transform: translateX(-50%); font-size: 14px; background: rgba(255, 255, 255, .6);
              padding: 6px 14px 8px; border-radius: 6px; white-space: nowrap; }
  #voertuig-hint { opacity: .75; margin-left: 6px; }
  #voertuig .cooldown { height: 4px; margin-top: 5px; background: rgba(0, 0, 0, .15); border-radius: 2px; overflow: hidden; }
  #cooldown-bar { display: block; height: 100%; width: 100%; background: #0f3f8f; transform-origin: left; }
  #kiezer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 6; padding: 14px 8vw 16px; color: #fff;
            background: linear-gradient(to top, rgba(8, 10, 16, .94), rgba(8, 10, 16, .7)); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .kiezer-kop { display: flex; justify-content: space-between; align-items: center; font-size: 13px; letter-spacing: .3em; text-transform: uppercase; opacity: .9; margin-bottom: 10px; }
  #vrij-link { color: #ffd479; text-decoration: none; border-bottom: 1px solid rgba(255, 212, 121, .5); letter-spacing: .2em; }
  .kiezer-kop .naam { display: flex; align-items: center; gap: 10px; }
  .kiezer-kop input { width: 180px; padding: 6px 10px; font: 14px "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 0; text-transform: none; color: #fff;
                      background: rgba(255, 255, 255, .1); border: 2px solid rgba(255, 255, 255, .2); border-radius: 8px; outline: none; }
  .kiezer-kop input:focus { border-color: #f2c14e; }
  .kaarten { display: flex; gap: 10px; }
  .kaart { flex: 1; position: relative; background: rgba(255, 255, 255, .08); border: 2px solid rgba(255, 255, 255, .12); border-radius: 10px;
           padding: 12px 14px 12px; cursor: pointer; transition: background .15s, border-color .15s; }
  .kaart:hover { background: rgba(255, 255, 255, .16); }
  .kaart.actief { border-color: #f2c14e; background: rgba(242, 193, 78, .18); }
  .kaart kbd { position: absolute; right: 10px; top: 9px; font: 11px/1 "Helvetica Neue", Helvetica, Arial, sans-serif; padding: 3px 6px; border-radius: 4px; background: rgba(255, 255, 255, .15); }
  .kaart b { display: block; font-size: 17px; margin-bottom: 2px; }
  .kaart .snelheid { color: #f2c14e; letter-spacing: 2px; font-size: 12px; }
  .kaart p { font-size: 12.5px; line-height: 1.35; opacity: .85; margin: 6px 0 0; }
  .kiezer-hint { font-size: 12px; opacity: .6; margin-top: 10px; }
  #laden.met-kiezer .laden-tekst { bottom: 320px; }
  #laden.met-kiezer .laden-voet { bottom: 250px; }
  #laden-kaart { position: absolute; left: 8vw; top: 6vh; width: 300px; height: 300px; z-index: 1; border-radius: 14px; border: 3px solid rgba(255, 255, 255, .75);
                 background: #e8e4d8; box-shadow: 0 3px 12px rgba(0, 0, 0, .4); }
  #laden-route { right: 8vw; top: 12vh; height: 42vh; z-index: 1; }
  #laden-route .route-kop { background: rgba(255, 255, 255, .85); }

  #stemmen { position: fixed; inset: 0; z-index: 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
             background: radial-gradient(ellipse at center, #1f2740 0%, #0b0d12 75%); color: #fff; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .stem-kop { font-size: 14px; letter-spacing: .3em; text-transform: uppercase; opacity: .75; }
  #stemmen h2 { margin: 0; font-size: clamp(30px, 4.5vw, 56px); font-weight: 800; letter-spacing: -.02em; }
  .stem-lijst { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; width: min(84vw, 1000px); }
  .stem-lijst button { position: relative; min-width: 170px; padding: 14px 44px 14px 16px; text-align: left; color: #fff; cursor: pointer; pointer-events: auto;
                       background: rgba(255, 255, 255, .08); border: 2px solid rgba(255, 255, 255, .14); border-radius: 10px; font: inherit; transition: background .15s, border-color .15s; }
  .stem-lijst button:hover { background: rgba(255, 255, 255, .16); }
  .stem-lijst button.mijn { border-color: #f2c14e; background: rgba(242, 193, 78, .18); }
  .stem-lijst b { display: block; font-size: 18px; }
  .stem-lijst span { font-size: 12px; opacity: .7; }
  .stem-lijst em { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font: 700 18px/1 "Helvetica Neue", Helvetica, Arial, sans-serif; color: #f2c14e; }
  #stemmen .stem-plaats { width: min(70vw, 460px); padding: 12px 16px; font: 16px "Helvetica Neue", Helvetica, Arial, sans-serif; color: #fff;
                          background: rgba(255, 255, 255, .1); border: 2px solid rgba(255, 255, 255, .2); border-radius: 10px; outline: none; }
  #stemmen input:focus { border-color: #f2c14e; }
  #stemmen .naam { position: absolute; right: 8vw; bottom: 6vh; display: flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: .3em; text-transform: uppercase; opacity: .9; }
  #stemmen .naam input { width: 180px; padding: 6px 10px; font: 14px "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 0; text-transform: none; color: #fff;
                         background: rgba(255, 255, 255, .1); border: 2px solid rgba(255, 255, 255, .2); border-radius: 8px; outline: none; }
  .stem-klok { font-size: 15px; letter-spacing: .2em; text-transform: uppercase; opacity: .8; font-variant-numeric: tabular-nums; }
</style>
